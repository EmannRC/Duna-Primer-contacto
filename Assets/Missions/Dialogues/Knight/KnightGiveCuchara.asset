  m_Script: {fileID: 11500000, guid: 7d96623effd3db54bbc459042cc8a6ab, type: 3}
  m_Name: KnightGiveCuchara
  m_EditorClassIdentifier: Assembly-CSharp::Duna.DialogueSystem.DialogueData
  dialogueID: Dialogue_give_cuchara_knight
  lines:
  - speakerName: Caballero timido
    text: Ah, mi cuchara favorita. Sin esta preciosura no podria disfrutar de mi
      sopa.
  - speakerName: Caballero timido
    text: "Bueno, ahora falta lo m\xE1s importante, los ingredientes. Y nada mejor
      que un buen ramen instantaneo con su huevo escalfado."

  m_Script: {fileID: 11500000, guid: 7d96623effd3db54bbc459042cc8a6ab, type: 3}
  m_Name: RobotBaseDialogue
  m_EditorClassIdentifier: Assembly-CSharp::Duna.DialogueSystem.DialogueData
  dialogueID: Dialogue_base_robot
  lines:
  - speakerName: Robot Averiado
    text: Parece que no soy lo unico que hay por arreglar. La invasion sigue ahi
      fuera y esa nave no va a retirarse sola.
  - speakerName: Robot Averiado
    text: Te recomiendo ir preparada, esos tipos no se andan con juegos.

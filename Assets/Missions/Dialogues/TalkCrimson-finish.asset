  m_Script: {fileID: 11500000, guid: 7d96623effd3db54bbc459042cc8a6ab, type: 3}
  m_Name: TalkCrimson-finish
  m_EditorClassIdentifier: Assembly-CSharp::Duna.DialogueSystem.DialogueData
  dialogueID: Dialogue_finish_crimson
  lines:
  - speakerName: Elfa carmesi
    text: "\xA1Vaya, has acabado con ellos! Debo reconocer que peleas bien para ser
      un elfo normie. Toma te lo has ganado, con esto podras patear m\xE1s traseros
      de ojalata."
